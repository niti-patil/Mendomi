{
  "name": "EmailLog",
  "type": "object",
  "properties": {
    "message_type": {
      "type": "string",
      "enum": [
        "medication_reminder",
        "daily_checkin",
        "appointment_reminder",
        "caregiver_alert"
      ],
      "description": "Which notification type this send was for"
    },
    "recipient_email": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "success",
        "failed"
      ],
      "default": "success"
    },
    "error_message": {
      "type": "string",
      "description": "Failure detail when delivery_status is failed"
    },
    "reference_date": {
      "type": "string",
      "format": "date",
      "description": "The day this reminder pertains to (used to enforce one-per-type-per-day)"
    }
  },
  "required": [
    "message_type",
    "recipient_email",
    "subject"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}