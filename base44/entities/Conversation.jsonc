{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ]
    },
    "content": {
      "type": "string"
    },
    "urgent_flag": {
      "type": "boolean",
      "default": false
    },
    "context_type": {
      "type": "string",
      "enum": [
        "assistant",
        "coach"
      ],
      "default": "assistant"
    }
  },
  "required": [
    "role",
    "content"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}