{
  "name": "QueuedQuestion",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "description": "A recovery question the patient wants to raise at their next visit"
    },
    "added_from_chat": {
      "type": "boolean",
      "default": false,
      "description": "True if saved directly from an Ask Mendy conversation"
    },
    "resolved": {
      "type": "boolean",
      "default": false,
      "description": "True once addressed in a generated Doctor Report"
    }
  },
  "required": [
    "question"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}